# Django Settings
DJANGO_SECRET_KEY=your-secret-key-change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL)
POSTGRES_DB=nifty_ai_trader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/nifty_ai_trader

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Keys
ANTHROPIC_API_KEY=your-claude-api-key-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather

# AI Configuration
AI_DEFAULT_MODEL=claude-3-haiku-20240307
AI_PREMIUM_MODEL=claude-3-5-sonnet-20240229
AI_CACHE_HOURS=6
AI_MAX_DAILY_ANALYSES=100

# Stock Market Settings
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_HOUR=9
MARKET_CLOSE_HOUR=15
PRICE_FETCH_INTERVAL_MINUTES=15

# Monitoring & Alerts
ADMIN_EMAIL=your-email@example.com
COST_ALERT_THRESHOLD=18.00

# Telegram Bot Settings
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_MAX_RETRIES=3
